{
  "name": "nosheet",
  "version": "0.1.0",
  "description": "Apply named, fully-typed row expressions and aggregates to tabular data. Expressions are plain arrow functions — no string formulas, no parsing, no eval.",
  "type": "module",
  "main": "./dist/nosheet.cjs",
  "module": "./dist/nosheet.esm.js",
  "browser": "./dist/nosheet.umd.js",
  "types": "./dist/nosheet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nosheet.d.ts",
      "import": "./dist/nosheet.esm.js",
      "require": "./dist/nosheet.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/nosheet.*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobstar-devman/noSheet.git"
  },
  "homepage": "https://github.com/lobstar-devman/noSheet#readme",
  "bugs": {
    "url": "https://github.com/lobstar-devman/noSheet/issues"
  },
  "scripts": {
    "build:tsc": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "api-extractor": "api-extractor run --local --verbose",
    "rollup": "rollup -c",
    "build": "rollup -c && api-extractor run --local --verbose",
    "dev:serve": "rollup -c -w",
    "prepublishOnly": "npm run lint && npm test && npm run clean && npm run build"
  },
  "keywords": [
    "table",
    "tabular",
    "dataframe",
    "expression",
    "aggregate",
    "spreadsheet",
    "computation",
    "typescript"
  ],
  "author": "nosheet",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.59.4",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-url": "^8.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "mathjs": "^15.2.0",
    "prettier": "^3.5.3",
    "rollup": "^4.60.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
